# Copy this file to `.env.local` when setting up local development.
# This is a template only. Do not put real secrets in this file.

NEXT_PUBLIC_APP_NAME=Hugmeid
NEXT_PUBLIC_APP_DESCRIPTION=医学生向けプラットフォーム
NEXT_PUBLIC_SITE_URL=http://localhost:3000
IMAGE_ALLOWED_REMOTE_HOSTS=

# Private Cloud Storage bucket used by GET /api/assets/public/... to serve
# sanitized images uploaded by the admin app. Keep the bucket itself private;
# grant the public Cloud Run runtime service account objectViewer instead.
GCS_PUBLIC_ASSET_BUCKET=

# Runtime environment labels used to prevent staging and production database mixups.
# Local development may omit these; Cloud Run staging/production must set both.
# Cloud SQL must also contain app_environment.database_environment with the same value.
HUGMEID_DEPLOY_ENV=local
HUGMEID_DATABASE_ENV=local

# Cloud SQL PostgreSQL connection used by Next.js Route Handlers.
# In Cloud Run, mount the instance and use PGHOST=/cloudsql/<connection-name>.
# Use a separate verified public runtime principal per environment. It must
# inherit only hugmeid_public_runtime and own no schema objects.
CLOUD_SQL_CONNECTION_NAME=
PGHOST=
PGPORT=5432
PGDATABASE=hugmeid
PGUSER=hugmeid_public_local
PGPASSWORD=
PGPOOL_MAX=5
# Optional: number of trusted proxy hops in X-Forwarded-For.
# Leave unset unless the production edge is verified to strip client-supplied values.
HUGMEID_TRUSTED_PROXY_HOPS=

# LIFF app id used by @line/liff in the browser.
# Use separate LINE Login channels and LIFF apps for staging and production.
NEXT_PUBLIC_LIFF_ID=

# Optional external LINE Login URL used outside the LIFF client flow.
NEXT_PUBLIC_LINE_LOGIN_URL=

# LINE Login channel credentials used only by server-side token verification.
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# Messaging API access token. Server-only; future push delivery jobs use this.
LINE_CHANNEL_ACCESS_TOKEN=

# Signed httpOnly application session cookie secret. Required in production.
SESSION_SECRET=

# Shared secret required on the `X-Admin-Revalidate-Secret` header for
# POST /api/admin/revalidate, called by the separate admin app after
# publish-impacting mutations. Must match REVALIDATE_ADMIN_SECRET in the
# admin app's env. Required for the admin app's cache invalidation to work;
# leaving it unset just means invalidation calls fail closed (401).
REVALIDATE_ADMIN_SECRET=

# Optional public external links.
NEXT_PUBLIC_SYLLABUS_URL=
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com

# Official LINE account add-friend URL used by the floating LINE action.
NEXT_PUBLIC_LINE_ADD_FRIEND_URL=

# Sponsor slots. One slot per route, rendered directly under the header.
# A slot renders ONLY when both the https URL and the name are set; otherwise
# nothing is shown. Never fill these with placeholder/fictional sponsors —
# an unsold slot must stay empty rather than display a fake ad.
NEXT_PUBLIC_SPONSOR_SCHOOL_URL=
NEXT_PUBLIC_SPONSOR_SCHOOL_NAME=
NEXT_PUBLIC_SPONSOR_SCHOOL_DESCRIPTION=
NEXT_PUBLIC_SPONSOR_JOBS_URL=
NEXT_PUBLIC_SPONSOR_JOBS_NAME=
NEXT_PUBLIC_SPONSOR_JOBS_DESCRIPTION=
NEXT_PUBLIC_SPONSOR_ACTIVITIES_URL=
NEXT_PUBLIC_SPONSOR_ACTIVITIES_NAME=
NEXT_PUBLIC_SPONSOR_ACTIVITIES_DESCRIPTION=
NEXT_PUBLIC_SPONSOR_CONTENTS_URL=
NEXT_PUBLIC_SPONSOR_CONTENTS_NAME=
NEXT_PUBLIC_SPONSOR_CONTENTS_DESCRIPTION=
