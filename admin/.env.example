# Copy this file to `.env.local` when setting up local development.
# This is a template only. Do not put real secrets in this file.

NEXT_PUBLIC_APP_NAME=Hugmeid Admin

# Runtime environment labels used to prevent staging and production database
# mixups. Same convention and same app_environment sentinel row as the public
# app (see ../.env.example and docs/admin-management-app-spec.md).
HUGMEID_DEPLOY_ENV=local
HUGMEID_DATABASE_ENV=local

# Cloud SQL PostgreSQL connection. PGUSER must be a verified environment-
# specific principal that inherits only hugmeid_admin_runtime. Never reuse the
# public app's runtime principal here.
CLOUD_SQL_CONNECTION_NAME=
PGHOST=
PGPORT=5432
PGDATABASE=hugmeid
PGUSER=hugmeid_admin_local
PGPASSWORD=
PGPOOL_MAX=5

# ---- 認証モード ----
# オープンアクセスモード: "true" にすると Google OAuth も admin_users の
# DB ルックアップも不要になり、管理画面のURLを知っていれば誰でも owner 権限で
# 利用できる。その場合は下記 GOOGLE_OAUTH_* / ADMIN_SESSION_SECRET は空でよい。
# 一般公開前には必ず無効化すること。
ADMIN_OPEN_ACCESS=

# Google OAuth/OIDC verification for admin access.
# - GOOGLE_OAUTH_CLIENT_ID and GOOGLE_OAUTH_CLIENT_SECRET are required in
#   staging/production unless ADMIN_OPEN_ACCESS=true.
# - GOOGLE_OAUTH_REDIRECT_URI must match the chosen admin HTTPS entrypoint,
#   for example the Cloud Run run.app URL or an optional custom domain.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# App-level Google OAuth admin session signing. Production and staging require
# a high-entropy value with at least 32 characters; public-app sessions are not
# accepted by the admin app. Not required when ADMIN_OPEN_ACCESS=true.
ADMIN_SESSION_SECRET=

# Local-only admin bypass. Must never be set outside local development; if set when
# HUGMEID_DEPLOY_ENV is not "local", the app rejects admin requests/access.
ADMIN_LOCAL_AUTH_BYPASS_EMAIL=

# Local-only FULL auth bypass (development). When "true" with
# HUGMEID_DEPLOY_ENV=local, no Google OAuth and no admin_users DB lookup is
# required: the app runs as a built-in owner admin. Refused outside local.
ADMIN_DEV_AUTH_BYPASS=

# Google Cloud Storage bucket used for Contents hero image uploads.
# Use a separate bucket per environment, e.g. hugmeid-public-assets-staging /
# hugmeid-public-assets-prod. GCP-side bucket/IAM provisioning is out of scope
# for this app's code.
GCS_PUBLIC_ASSET_BUCKET=
# Required for real uploads outside test fixtures. Must point at the
# matching public app origin plus /api/assets/public, never a direct
# storage.googleapis.com bucket URL.
GCS_PUBLIC_ASSET_BASE_URL=

# Shared secret sent as the `X-Admin-Revalidate-Secret` header when calling the
# public app's protected revalidation endpoint after publish-impacting
# mutations. Must match REVALIDATE_ADMIN_SECRET in the public app's env.
PUBLIC_APP_REVALIDATE_URL=
REVALIDATE_ADMIN_SECRET=
