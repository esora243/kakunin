{
  "name": "hugmeid-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build --webpack",
    "start": "next start -p ${PORT:-3100}",
    "lint": "eslint .",
    "test": "npm run test:compile && node scripts/run-node-tests.mjs && node --test scripts/backfill-asset-variants.test.mjs",
    "test:compile": "rm -rf .test-dist && tsc -p tsconfig.test.json",
    "test:coverage": "npm run test:compile && c8 node scripts/run-node-tests.mjs",
    "typecheck": "tsc --noEmit",
    "assets:backfill": "node scripts/backfill-asset-variants.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.14.0",
    "@types/busboy": "^1.5.4",
    "busboy": "^1.6.0",
    "lucide-react": "^0.487.0",
    "marked": "^12.0.2",
    "next": "16.2.11",
    "pg": "^8.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.3",
    "sonner": "^2.0.3",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.20.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "c8": "^12.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "postcss": "8.5.23",
    "postcss-load-config": "^6.0.1",
    "tailwindcss": "^3.4.13",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "$sharp",
    "uuid": "^11.1.1"
  }
}
