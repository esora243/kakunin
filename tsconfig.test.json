{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "incremental": false,
    "isolatedModules": false,
    "jsx": "react-jsx",
    "module": "CommonJS",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".test-dist",
    "rootDir": ".",
    "target": "ES2022",
    "types": [
      "node"
    ],
    "noEmitOnError": false,
    "skipLibCheck": true
  },
  "include": [
    "lib*.ts",
    "app/apiroute.ts",
    "app/school/school-workspace-shared.ts",
    "tests*.test.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".test-dist"
  ]
}